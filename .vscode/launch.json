{
  "version": "0.2.0",
  "configurations": [
    {
      // ─────────────────────────────────────────────────────────────
      // الويب — منفذ ثابت إلزامي
      //
      // ⚠️ لا تحذف --web-port. تخزين المتصفح (OPFS و IndexedDB) مرتبط
      //    بـ «الأصل» = المضيف:المنفذ. و flutter run يختار منفذاً عشوائياً
      //    في كل تشغيل بلا هذا الإعداد، فيصير كل تشغيل أصلاً جديداً
      //    بقاعدة بيانات فارغة — وتضيع كل البيانات بين جلسة وأخرى.
      // ─────────────────────────────────────────────────────────────
      "name": "سند — ويب (منفذ ثابت 5000)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--web-port=5000", "--web-hostname=localhost"]
    },
    {
      // نسخة سطح المكتب — قاعدة البيانات ملف حقيقي في Documents
      // لا تتأثر بالمنافذ إطلاقاً. الأنسب للاختبار الجاد.
      "name": "سند — ويندوز",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "windows"
    }
  ]
}
